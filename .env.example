
# Lead storage (MongoDB). Paste the FlightKlub cluster connection string here.
# It looks like: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# A NEW database on that cluster, so FlightKlub's own data is never touched.
MONGODB_DB=gaint_company

# Optional: email an alert for every new enquiry (Resend, resend.com)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
# RESEND_FROM="The Gaint Company <leads@yourdomain.com>"

# Optional: only if the live site URL changes
# NEXT_PUBLIC_SITE_URL=https://thegaintcompany.com
